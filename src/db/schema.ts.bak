	commentsCount: integer().default(0).notNull(),
	createdAt: numeric().default(sql`(CURRENT_TIMESTAMP)`).notNull(),
},
(table) => [
	uniqueIndex("CommunityDailyVerse_communityId_date_key").on(table.communityId, table.date),
]);

