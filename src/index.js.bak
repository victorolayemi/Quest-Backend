bject","type":"ChatClear","relationName":"ChatClearToUser"},{"name":"subscriptions","kind":"object","type":"Subscription","relationName":"SubscriptionToUser"},{"name":"userMedia","kind":"object","type":"UserMedia","relationName":"UserToUserMedia"},{"name":"createdCommunities","kind":"object","type":"Community","relationName":"CommunityCreator"},{"name":"savedBooks","kind":"object","type":"SavedBook","relationName":"SavedBookToUser"},{"name":"communityVerseLikes","kind":"object","type":"CommunityDailyVerseLike","relationName":"CommunityDailyVerseLikeToUser"},{"name":"CommunityMessageLike","kind":"object","type":"CommunityMessageLike","relationName":"CommunityMessageLikeToUser"},{"name":"CommunityMessageBookmark","kind":"object","type":"CommunityMessageBookmark","relationName":"CommunityMessageBookmarkToUser"},{"name":"CommunityMessageComment","kind":"object","type":"CommunityMessageComment","relationName":"CommunityMessageCommentToUser"},{"name":"CommunityMessageReaction","kind":"object","type":"CommunityMessageReaction","relationName":"CommunityMessageReactionToUser"},{"name":"CommunityMessageCommentLike","kind":"object","type":"CommunityMessageCommentLike","relationName":"CommunityMessageCommentLikeToUser"}],"dbName":null},"OtpRequest":{"fields":[{"name":"id","kind":"scalar","type":"String"},{"name":"contact","kind":"scalar","type":"String"},{"name":"code","kind":"scalar","type":"String"},{"name":"expiresAt","kind":"scalar","type":"DateTime"},{"name":"verified","kind":"scalar","type":"Boolean"},{"name":"userId","kind":"scalar","type":"String"},{"name":"user","kind":"object","type":"User","relationName":"OtpRequestToUser"}],"dbName":null},"UserFeeling":{"fields":[{"name":"id","kind":"scalar","type":"String"},{"name":"userId","kind":"scalar","type":"String"},{"name":"feeling","kind":"scalar","type":"String"},{"name":"emoji","kind":"scalar","type":"String"},{"name":"createdAt","kind":"scalar","type":"DateTime"},{"name":"user","kind":"object","type":"User","relationNam