// src/middleware/adminAuth.ts
async function adminAuthMiddleware(c, next) {
  const authHeader = c.req.header("Authorization");
  if (!authHeader || !authHeader.startsWith("Bearer ")) {
    return c.json({ error: "Unauthorized: Missing or invalid token" }, 401);
  }
  const token = authHeader.split(" ")[1];
  try {
    const secret = c.env.JWT_SECRET;
    if (!secret) {
      return c.json({ error: "Internal Server Error: JWT_SECRET not configured" }, 500);
    }
    const payload = await verify2(token, secret, "HS256");
    const userId = payload.sub;
    const prisma = getPrisma(c.env.DB);
    const user = await prisma.user.findUnique({
      where: { id: userId },
      select: { isAdmin: true }
    });
    if (!user || !user.isAdmin) {
      return c.json({ error: "Forbidden: Admin access required" }, 403);
    }
    c.set("userId", userId);
    await next();
  } catch (err2) {
    return c.json({ error: "Unauthorized: Invalid token" }, 401);
  }
}
__name(adminAuthMiddleware, "adminAuthMiddleware");

// src/routes/admin.ts
var admin = new Hono2();
admin.use("*", adminAuthMiddleware);
async function hashPassword2(password, existingSalt) {
  const encoder2 = new TextEncoder();
  const passwordKey = await crypto.subtle.importKey(
    "raw",
    encoder2.encode(password),
    { name: "PBKDF2" },
    false,
    ["deriveBits"]
  );
  let salt;
  if (existingSalt) {
    salt = new Uint8Array(existingSalt.match(/.{1,2}/g).map((byte) => parseInt(byte, 16)));
  } else {
    salt = crypto.getRandomValues(new Uint8Array(16));
  }
  const hashBuffer = await crypto.subtle.deriveBits(
    {
      name: "PBKDF2",
      salt,
      iterations: 1e5,
      hash: "SHA-256"
    },
    passwordKey,
    256
  );
  const hashArray = Array.from(new Uint8Array(hashBuffer));
  const hashHex = hashArray.map((b) => b.toString(16).padStart(2, "0")).join("");
  const saltHex = Array.from(salt).map((b) => b.toString(16).padStart(2, "0")).join("");
  return `${saltHex}:${hashHex}`;
}
__name(hashPassword2, "hashPassword");
