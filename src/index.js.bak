      "inlineSchema": 'generator client {\n  provider        = "prisma-client-js"\n  previewFeatures = ["driverAdapters"]\n}\n\ndatasource db {\n  provider = "sqlite"\n  url      = "file:./dev.db"\n}\n\nmodel User {\n  id                          String                        @id @default(uuid())\n  email                       String?                       @unique\n  phoneNumber                 String?                       @unique\n  password                    String?\n  firstName                   String?\n  lastName                    String?\n  username                    String?                       @unique\n  gender                      String?\n  avatarUrl                   String?\n  bio                         String?\n  points                      Int                           @default(0)\n  streakCount                 Int                           @default(0)\n  isGuest                     Boolean                       @default(false)\n  isAdmin                     Boolean                       @default(false)\n  isBanned                    Boolean                       @default(false)\n  location                    String?\n  appearance                  String                        @default("system")\n  soundAlerts                 Boolean                       @default(true)\n  hapticFeedback              Boolean                       @default(true)\n  music                       Boolean                       @default(true)\n  allNotifications            Boolean                       @default(true)\n  inAppNotifications          Boolean                       @default(true)\n  pushDirectMessages          Boolean                       @default(true)\n  pushCommunityPosts          Boolean                       @default(true)\n  pushCommunityForum          Boolean                       @default(true)\n  pushConnectionRequests      Boolean                       @default(true)\n  pushConnectionAccepted      Boolean                       @default(true)\n  doNotDisturb                Boolean                       @default(false)\n  autoScroll                  Boolean                       @default(false)\n  reminderMorning             Boolean                       @default(false)\n  reminderAfternoon           Boolean                       @default(false)\n  reminderEvening             Boolean                       @default(false)\n  reminderCustomTime          String?\n  createdAt                   DateTime                      @default(now())\n  updatedAt                   DateTime                      @updatedAt\n  bookmarks                   BibleBookmark[]\n  highlights                  BibleHighlight[]\n  bibleNotes                  BibleNote[]\n  readingHistory              BibleReadingHistory[]\n  opponentChallenges          Challenge[]                   @relation("ChallengeOpponent")\n  createdChallenges           Challenge[]                   @relation("ChallengeCreator")\n  challengeScores             ChallengeParticipant[]\n  comments                    Comment[]\n  communityMemberships        CommunityMember[]\n  communityJoinRequests       CommunityJoinRequest[]\n  dailyBreadAttempts          DailyBreadAttempt[]\n  chat2                       DirectChat[]                  @relation("User2")\n  chat1                       DirectChat[]                  @relation("User1")\n  sentMessages                DirectMessage[]\n  earnedBadges                EarnedBadge[]\n  eventRSVPs                  EventAttendee[]\n  recvFriendRequests          FriendRequest[]               @relation("RecvRequests")\n  sentFriendRequests          FriendRequest[]               @relation("SentRequests")\n  groupMessages               GroupMessage[]\n  communityMessages           CommunityMessage[]\n  journals                    JournalEntry[]\n  notifications               Notification[]\n  otpRequests                 OtpRequest[]\n  notes                       PersonalNote[]\n  mediaProgress               PlayProgress[]\n  posts                       Post[]\n  postReactions               PostReaction[]\n  quizAttempts                QuizAttempt[]\n  currentFeeling              UserFeeling?\n  devotionProgress            UserPlanProgress[]\n  devotionDayLikes            DevotionDayLike[]\n  loginHistory                LoginHistory[]\n  gameScores                  GameScore[]\n  fcmToken                    String?\n  dailyVerseLikes             DailyVerseLike[]\n  bibleQuizLevel              Int                           @default(1)\n  bookComments                BookComment[]\n  bookReactions               BookReaction[]\n  mediaLikes                  MediaLike[]\n  postReports                 PostReport[]\n  commentReactions            CommentReaction[]\n  ChatClear                   ChatClear[]\n  subscriptions               Subscription[]\n  userMedia                   UserMedia[]\n  createdCommunities          Community[]                   @relation("CommunityCreator")\n  savedBooks                  SavedBook[]\n  communityVerseLikes         CommunityDailyVerseLike[]\n  CommunityMessageLike        CommunityMessageLike[]\n  CommunityMessageBookmark    CommunityMessageBookmark[]\n  CommunityMessageComment     CommunityMessageComment[]\n  CommunityMessageReaction    CommunityMessageReaction[]\n  CommunityMessageCommentLike CommunityMessageCommentLike[]\n}\n\nmodel OtpRequest {\n  id        String   @id @default(uuid())\n  contact   String\n  code      String\n  expiresAt DateTime\n  verified  Boolean  @default(false)\n  userId    String?\n  user      User?    @relation(fields: [userId], references: [id])\n}\n\nmodel UserFeeling {\n  id        String   @id @default(uuid())\n  userId    String   @unique\n  feeling   String\n  emoji     String\n  createdAt DateTime @default(now())\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n}\n\nmodel FriendRequest {\n  id         String   @id @default(uuid())\n  senderId   String\n  receiverId String\n  status     String   @default("PENDING")\n  createdAt  DateTime @default(now())\n  receiver   User     @relation("RecvRequests", fields: [receiverId], references: [id], onDelete: Cascade)\n  sender     User     @relation("SentRequests", fields: [senderId], references: [id], onDelete: Cascade)\n}\n\nmodel DirectChat {\n  id        String          @id @default(uuid())\n  user1Id   String\n  user2Id   String\n  createdAt DateTime        @default(now())\n  pins      ChatPin[]\n  user2     User            @relation("User2", fields: [user2Id], references: [id], onDelete: Cascade)\n  user1     User            @relation("User1", fields: [user1Id], references: [id], onDelete: Cascade)\n  messages  DirectMessage[]\n  ChatClear ChatClear[]\n}\n\nmodel DirectMessage {\n  id        String     @id @default(uuid())\n  chatId    String\n  senderId  String\n  text      String\n  image     String?\n  isRead    Boolean    @default(false)\n  createdAt DateTime   @default(now())\n  sender    User       @relation(fields: [senderId], references: [id], onDelete: Cascade)\n  chat      DirectChat @relation(fields: [chatId], references: [id], onDelete: Cascade)\n}\n\nmodel ChatPin {\n  id       String     @id @default(uuid())\n  chatId   String\n  userId   String\n  pinnedAt DateTime   @default(now())\n  chat     DirectChat @relation(fields: [chatId], references: [id], onDelete: Cascade)\n}\n\nmodel JournalEntry {\n  id        String   @id @default(uuid())\n  userId    String\n  title     String\n  bodyText  String\n  feelings  String\n  verses    String?\n  createdAt DateTime @default(now())\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n}\n\nmodel PersonalNote {\n  id         String   @id @default(uuid())\n  userId     String\n  title      String\n  bodyText   String\n  isFavorite Boolean  @default(false)\n  images     String\n  createdAt  DateTime @default(now())\n  verses     String?\n  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n}\n\nmodel Community {\n  id                      String                 @id @default(uuid())\n  name                    String                 @unique\n  description             String\n  image                   String?\n  guidelines              String?\n  isPrivate               Boolean                @default(false)\n  isForumDisabledGlobally Boolean                @default(false)\n  createdAt               DateTime               @default(now())\n  events                  CommunityEvent[]\n  members                 CommunityMember[]\n  messages                GroupMessage[]\n  communityMessages       CommunityMessage[]\n  posts                   Post[]\n  joinRequests            CommunityJoinRequest[]\n  creatorId               String?\n  creator                 User?                  @relation("CommunityCreator", fields: [creatorId], references: [id])\n  communityVerses         CommunityDailyVerse[]\n}\n\nmodel CommunityJoinRequest {\n  id          String    @id @default(uuid())\n  communityId String\n  userId      String\n  status      String    @default("PENDING") // PENDING, APPROVED, REJECTED\n  createdAt   DateTime  @default(now())\n  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  community   Community @relation(fields: [communityId], references: [id], onDelete: Cascade)\n}\n\nmodel CommunityMember {\n  id           String    @id @default(uuid())\n  communityId  String\n  userId       String\n  role         String    @default("MEMBER")\n  isSuspended  Boolean   @default(false)\n  canPostForum Boolean   @default(true)\n  joinedAt     DateTime  @default(now())\n  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  community    Community @relation(fields: [communityId], references: [id], onDelete: Cascade)\n}\n\nmodel Post {\n  id          String         @id @default(uuid())\n  communityId String\n  userId      String\n  text        String\n  image       String?\n  createdAt   DateTime       @default(now())\n  comments    Comment[]\n  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)\n  community   Community      @relation(fields: [communityId], references: [id], onDelete: Cascade)\n  reactions   PostReaction[]\n  reports     PostReport[]\n}\n\nmodel PostReaction {\n  id        String   @id @default(uuid())\n  postId    String\n  userId    String\n  emoji     String\n  createdAt DateTime @default(now())\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)\n}\n\nmodel Comment {\n  id        String            @id @default(uuid())\n  postId    String\n  userId    String\n  parentId  String?\n  text      String\n  createdAt DateTime          @default(now())\n  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)\n  post      Post              @relation(fields: [postId], references: [id], onDelete: Cascade)\n  parent    Comment?          @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)\n  replies   Comment[]         @relation("CommentReplies")\n  reactions CommentReaction[]\n}\n\nmodel CommentReaction {\n  id        String   @id @default(uuid())\n  commentId String\n  userId    String\n  emoji     String   @default("\u{1F44D}")\n  createdAt DateTime @default(now())\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)\n\n  @@unique([userId, commentId])\n}\n\nmodel CommunityEvent {\n  id          String          @id @default(uuid())\n  communityId String\n  title       String\n  description String\n  date        String\n  time        String\n  location    String\n  link        String?\n  imageUrl    String?\n  createdAt   DateTime        @default(now())\n  community   Community       @relation(fields: [communityId], references: [id], onDelete: Cascade)\n  attendees   EventAttendee[]\n}\n\nmodel EventAttendee {\n  id      String         @id @default(uuid())\n  eventId String\n  userId  String\n  joined  DateTime       @default(now())\n  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)\n  event   CommunityEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)\n}\n\nmodel GroupMessage {\n  id             String    @id @default(uuid())\n  communityId    String\n  senderId       String\n  text           String\n  imageUrl       String?\n  videoUrl       String?\n  videoThumbnail String?\n  audioUrl       String?\n  audioThumbnail String?\n  createdAt      DateTime  @default(now())\n  sender         User      @relation(fields: [senderId], references: [id], onDelete: Cascade)\n  community      Community @relation(fields: [communityId], references: [id], onDelete: Cascade)\n}\n\nmodel CommunityMessage {\n  id             String    @id @default(uuid())\n  communityId    String\n  senderId       String\n  text           String\n  title          String?\n  imageUrl       String?\n  videoUrl       String?\n  videoThumbnail String?\n  audioUrl       String?\n  audioThumbnail String?\n  likesCount     Int       @default(0)\n  commentsCount  Int       @default(0)\n  sharesCount    Int       @default(0)\n  bookmarksCount Int       @default(0)\n  createdAt      DateTime  @default(now())\n  sender         User      @relation(fields: [senderId], references: [id], onDelete: Cascade)\n  community      Community @relation(fields: [communityId], references: [id], onDelete: Cascade)\n\n  likes     CommunityMessageLike[]\n  bookmarks CommunityMessageBookmark[]\n  comments  CommunityMessageComment[]\n  reactions CommunityMessageReaction[]\n}\n\nmodel CommunityMessageLike {\n  id        String           @id @default(uuid())\n  userId    String\n  messageId String\n  createdAt DateTime         @default(now())\n  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)\n  message   CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)\n\n  @@unique([userId, messageId])\n}\n\nmodel CommunityMessageBookmark {\n  id        String           @id @default(uuid())\n  userId    String\n  messageId String\n  createdAt DateTime         @default(now())\n  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)\n  message   CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)\n\n  @@unique([userId, messageId])\n}\n\nmodel CommunityMessageComment {\n  id        String   @id @default(uuid())\n  userId    String\n  messageId String\n  text      String\n  parentId  String?\n  createdAt DateTime @default(now())\n\n  user       User                          @relation(fields: [userId], references: [id], onDelete: Cascade)\n  message    CommunityMessage              @relation(fields: [messageId], references: [id], onDelete: Cascade)\n  parent     CommunityMessageComment?      @relation("MessageCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)\n  replies    CommunityMessageComment[]     @relation("MessageCommentReplies")\n  likes      CommunityMessageCommentLike[]\n  likesCount Int                           @default(0)\n}\n\nmodel BibleBookmark {\n  id        String   @id @default(uuid())\n  userId    String\n  verseRef  String\n  createdAt DateTime @default(now())\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n}\n\nmodel BibleHighlight {\n  id        String   @id @default(uuid())\n  userId    String\n  verseRef  String\n  color     String\n  createdAt DateTime @default(now())\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n}\n\nmodel BibleNote {\n  id        String   @id @default(uuid())\n  userId    String\n  verseRef  String\n  noteText  String\n  createdAt DateTime @default(now())\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n}\n\nmodel BibleReadingHistory {\n  id       String   @id @default(uuid())\n  userId   String\n  verseRef String\n  readAt   DateTime @default(now())\n  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n}\n\nmodel DevotionPlan {\n  id           String        @id @default(uuid())\n  title        String\n  description  String\n  image        String?\n  durationDays Int\n  authorName   String\n  authorHandle String\n  tag          String\n  createdAt    DateTime      @default(now())\n  days         DevotionDay[]\n}\n\nmodel DevotionDay {\n  id           String            @id @default(uuid())\n  planId       String\n  dayNumber    Int\n  title        String\n  bodyText     String\n  image        String?\n  videoUrl     String?\n  pointsEarned Int               @default(20)\n  likesCount   Int               @default(0)\n  createdAt    DateTime          @default(now())\n  plan         DevotionPlan      @relation(fields: [planId], references: [id], onDelete: Cascade)\n  likes        DevotionDayLike[]\n}\n\nmodel DevotionDayLike {\n  id        String      @id @default(uuid())\n  userId    String\n  dayId     String\n  createdAt DateTime    @default(now())\n  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)\n  day       DevotionDay @relation(fields: [dayId], references: [id], onDelete: Cascade)\n\n  @@unique([userId, dayId])\n}\n\nmodel UserPlanProgress {\n  id              String    @id @default(uuid())\n  userId          String\n  planId          String\n  currentDay      Int       @default(1)\n  reminderTime    String    @default("09:41 AM")\n  reminderEnabled Boolean   @default(true)\n  startedAt       DateTime  @default(now())\n  completedAt     DateTime?\n  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n}\n\nmodel SermonMedia {\n  id         String         @id @default(uuid())\n  title      String\n  author     String\n  mediaUrl   String\n  imageUrl   String\n  type       String\n  duration   String\n  category   String\n  createdAt  DateTime       @default(now())\n  playbacks  PlayProgress[]\n  mediaLikes MediaLike[]\n}\n\nmodel PlayProgress {\n  id              String      @id @default(uuid())\n  userId          String\n  mediaId         String\n  progressSeconds Int         @default(0)\n  completed       Boolean     @default(false)\n  updatedAt       DateTime    @updatedAt\n  media           SermonMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)\n  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)\n}\n\nmodel Quiz {\n  id         String        @id @default(uuid())\n  title      String\n  category   String\n  difficulty String\n  points     Int           @default(50)\n  createdAt  DateTime      @default(now())\n  questions  Question[]\n  attempts   QuizAttempt[]\n}\n\nmodel Question {\n  id                 String @id @default(uuid())\n  quizId             String\n  questionText       String\n  options            String\n  correctAnswerIndex Int\n  points             Int    @default(10)\n  quiz               Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)\n}\n\nmodel QuizAttempt {\n  id           String   @id @default(uuid())\n  userId       String\n  quizId       String\n  score        Int\n  pointsEarned Int\n  completedAt  DateTime @default(now())\n  quiz         Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)\n  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n}\n\nmodel DailyBread {\n  id         String              @id @default(uuid())\n  date       String              @unique\n  puzzleData String\n  solution   String\n  attempts   DailyBreadAttempt[]\n}\n\nmodel DailyBreadAttempt {\n  id           String     @id @default(uuid())\n  userId       String\n  dailyBreadId String\n  solved       Boolean    @default(false)\n  streakAt     DateTime   @default(now())\n  createdAt    DateTime   @default(now())\n  dailyBread   DailyBread @relation(fields: [dailyBreadId], references: [id], onDelete: Cascade)\n  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)\n}\n\nmodel Challenge {\n  id           String                 @id @default(uuid())\n  creatorId    String\n  opponentId   String?\n  quizId       String\n  type         String\n  status       String                 @default("PENDING")\n  inviteCode   String                 @unique\n  createdAt    DateTime               @default(now())\n  opponent     User?                  @relation("ChallengeOpponent", fields: [opponentId], references: [id], onDelete: Cascade)\n  creator      User                   @relation("ChallengeCreator", fields: [creatorId], references: [id], onDelete: Cascade)\n  participants ChallengeParticipant[]\n}\n\nmodel ChallengeParticipant {\n  id          String    @id @default(uuid())\n  challengeId String\n  userId      String\n  score       Int       @default(0)\n  completed   Boolean   @default(false)\n  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)\n  challenge   Challenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)\n}\n\nmodel Badge {\n  id            String        @id @default(uuid())\n  name          String        @unique\n  description   String\n  imageUrl      String\n  criteriaType  String\n  criteriaValue Int\n  earnedBy      EarnedBadge[]\n}\n\nmodel EarnedBadge {\n  id       String   @id @default(uuid())\n  userId   String\n  badgeId  String\n  earnedAt DateTime @default(now())\n  badge    Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)\n  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n}\n\nmodel Notification {\n  id        String   @id @default(uuid())\n  userId    String\n  title     String\n  message   String\n  type      String   @default("SYSTEM")\n  isRead    Boolean  @default(false)\n  createdAt DateTime @default(now())\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n}\n\nmodel AppFeature {\n  id        String   @id @default(uuid())\n  key       String   @unique\n  isEnabled Boolean  @default(true)\n  value     String?\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n}\n\nmodel LoginHistory {\n  id        String   @id @default(uuid())\n  userId    String\n  ip        String?\n  browser   String?\n  os        String?\n  createdAt DateTime @default(now())\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n}\n\nmodel WordMatchQuestion {\n  id         String   @id @default(uuid())\n  word       String\n  match      String\n  difficulty String   @default("easy")\n  createdAt  DateTime @default(now())\n  updatedAt  DateTime @updatedAt\n}\n\nmodel WordCrossQuestion {\n  id         String   @id @default(uuid())\n  word       String\n  clue       String\n  difficulty String   @default("easy")\n  createdAt  DateTime @default(now())\n  updatedAt  DateTime @updatedAt\n}\n\nmodel GameSettings {\n  id             String   @id @default(uuid())\n  gameType       String   @unique\n  totalQuestions Int      @default(10)\n  durationSecs   Int      @default(60)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n}\n\nmodel GameScore {\n  id         String   @id @default(uuid())\n  userId     String\n  gameType   String\n  difficulty String\n  score      Int\n  createdAt  DateTime @default(now())\n  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n}\n\nmodel BibleQuizQuestion {\n  id                 String   @id @default(uuid())\n  questionText       String\n  options            String\n  correctAnswerIndex Int\n  level              Int      @default(1)\n  createdAt          DateTime @default(now())\n  updatedAt          DateTime @updatedAt\n}\n\nmodel DailyVerseStat {\n  id       String @id @default(uuid())\n  date     String @unique // e.g., "YYYY-MM-DD"\n  likes    Int    @default(0)\n  shares   Int    @default(0)\n  comments Int    @default(0)\n}\n\nmodel DailyVerseLike {\n  id        String   @id @default(uuid())\n  userId    String\n  date      String\n  createdAt DateTime @default(now())\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([userId, date])\n}\n\nmodel Book {\n  id          String         @id @default(uuid())\n  title       String\n  author      String\n  description String?\n  imageUrl    String?\n  downloadUrl String?\n  topic       String?\n  createdAt   DateTime       @default(now())\n  updatedAt   DateTime       @updatedAt\n  comments    BookComment[]\n  reactions   BookReaction[]\n  savedBy     SavedBook[]\n}\n\nmodel BookComment {\n  id        String   @id @default(uuid())\n  content   String\n  bookId    String\n  userId    String\n  createdAt DateTime @default(now())\n  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n}\n\nmodel BookReaction {\n  id        String   @id @default(uuid())\n  bookId    String\n  userId    String\n  emoji     String\n  createdAt DateTime @default(now())\n  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([bookId, userId, emoji])\n}\n\nmodel MediaLike {\n  id        String      @id @default(uuid())\n  userId    String\n  mediaId   String\n  createdAt DateTime    @default(now())\n  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)\n  media     SermonMedia @relation(fields: [mediaId], references: [id], onDelete: Cascade)\n\n  @@unique([userId, mediaId])\n}\n\nmodel PostReport {\n  id        String   @id @default(uuid())\n  postId    String\n  userId    String\n  reason    String\n  createdAt DateTime @default(now())\n  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n}\n\nmodel ChatClear {\n  id        String     @id @default(uuid())\n  chatId    String\n  userId    String\n  clearedAt DateTime   @default(now())\n  chat      DirectChat @relation(fields: [chatId], references: [id], onDelete: Cascade)\n  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)\n\n  @@unique([chatId, userId])\n}\n\nmodel Affirmation {\n  id        String   @id @default(uuid())\n  feeling   String? // Nullable. If null, it represents a general/default affirmation.\n  text      String\n  createdAt DateTime @default(now())\n}\n\nmodel Subscription {\n  id             String   @id @default(uuid())\n  userId         String\n  platform       String // "apple", "google"\n  status         String // "active", "expired", "cancelled"\n  originalTxId   String   @unique\n  productId      String\n  expiresAt      DateTime\n  isAutoRenewing Boolean  @default(true)\n  createdAt      DateTime @default(now())\n  updatedAt      DateTime @updatedAt\n  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n}\n\nmodel UserMedia {\n  id        String   @id @default(uuid())\n  userId    String\n  title     String\n  mediaUrl  String\n  type      String // "video", "audio"\n  createdAt DateTime @default(now())\n  updatedAt DateTime @updatedAt\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n}\n\nmodel SavedBook {\n  id        String   @id @default(uuid())\n  userId    String\n  bookId    String\n  createdAt DateTime @default(now())\n  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)\n  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)\n\n  @@unique([userId, bookId])\n}\n\nmodel CommunityDailyVerse {\n  id            String   @id @default(uuid())\n  communityId   String\n  date          String // "YYYY-MM-DD"\n  reference     String\n  text          String\n  explanation   String?\n  likesCount    Int      @default(0)\n  sharesCount   Int      @default(0)\n  commentsCount Int      @default(0)\n  createdAt     DateTime @default(now())\n\n  community Community                 @relation(fields: [communityId], references: [id], onDelete: Cascade)\n  likes     CommunityDailyVerseLike[]\n\n  @@unique([communityId, date])\n}\n\nmodel CommunityDailyVerseLike {\n  id        String   @id @default(uuid())\n  userId    String\n  verseId   String\n  createdAt DateTime @default(now())\n\n  user  User                @relation(fields: [userId], references: [id], onDelete: Cascade)\n  verse CommunityDailyVerse @relation(fields: [verseId], references: [id], onDelete: Cascade)\n\n  @@unique([userId, verseId])\n}\n\nmodel CommunityMessageReaction {\n  id        String           @id @default(uuid())\n  userId    String\n  messageId String\n  emoji     String\n  createdAt DateTime         @default(now())\n  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)\n  message   CommunityMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)\n\n  @@unique([userId, messageId, emoji])\n}\n\nmodel CommunityMessageCommentLike {\n  id        String                  @id @default(uuid())\n  userId    String\n  commentId String\n  createdAt DateTime                @default(now())\n  user      User                    @relation(fields: [userId], references: [id], onDelete: Cascade)\n  comment   CommunityMessageComment @relation(fields: [commentId], references: [id], onDelete: Cascade)\n\n  @@unique([userId, commentId])\n}\n',
