    take: 20,
    ...cursor ? { skip: 1, cursor: { id: cursor } } : {},
    include: {
      user: { select: { firstName: true, lastName: true, username: true, avatarUrl: true } },
      reactions: true,
      _count: { select: { comments: true } }
    },
