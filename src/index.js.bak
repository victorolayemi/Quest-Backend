    record = await prisma.playProgress.update({
      where: { id: existing.id },
      data: {
        progressSeconds: progressSeconds ?? 0,
        completed: completed ?? false
      }
    });
  } else {
    record = await prisma.playProgress.create({
      data: {
        userId,
        mediaId,
        progressSeconds: progressSeconds ?? 0,
        completed: completed ?? false
      }
    });
  }
  if (completed && (!existing || !existing.completed)) {
