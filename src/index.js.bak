      type: "COMMENT_DELETED",
      pushSettingKey: "pushCommunityPosts",
      fcm,
      data: { type: "COMMENT_DELETED", communityId: comment.post.communityId }
    });
  }
  return c.json({ message: "Comment deleted successfully" });
});
