{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "bible-app",
	"main": "src/index.ts",
	"compatibility_date": "2026-05-19",
	"compatibility_flags": [
		"nodejs_compat",
		"no_handle_cross_request_promise_resolution"
	],
	"assets": {
		"directory": "../admin/dist",
		"binding": "ASSETS"
	},
	"r2_buckets": [
		{
			"binding": "MEDIA_BUCKET",
			"bucket_name": "bible-app-media"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "bible-app-db",
			//"database_id": "00000000-0000-0000-0000-000000000000"
			"database_id": "c2908fbc-b8f9-453e-a385-2f70468fdae1"
		}
	],
	"vars": {
		"JWT_SECRET": "[ENCRYPTION_KEY]",
		"FIREBASE_CLIENT_EMAIL": "firebase-adminsdk-fbsvc@bible-quest-e00ee.iam.gserviceaccount.com",
		"FIREBASE_PRIVATE_KEY": "[ENCRYPTION_KEY]",
		"VITE_API_URL": "https://quest.vidarave.com/api/v1",
		"TWILIO_ACCOUNT_SID": "[ENCRYPTION_KEY]",
		"TWILIO_AUTH_TOKEN": "[ENCRYPTION_KEY]",
		"TWILIO_PHONE_NUMBER": "+18059736828",
		"MAILCHANNELS_API_KEY": "[ENCRYPTION_KEY]"
	},
	"triggers": {
		"crons": [
			"0 12 * * *"
		]
	},
	"queues": {
		"producers": [
			{
				"binding": "NOTIFICATION_QUEUE",
				"queue": "notification-queue"
			}
		],
		"consumers": [
			{
				"queue": "notification-queue",
				"max_batch_size": 10,
				"max_batch_timeout": 5,
				"max_retries": 3
			}
		]
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true
		}
	}
}